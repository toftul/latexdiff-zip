# Quadlet network unit: isolated network with NO route to the internet.
# The webapp (which compiles untrusted uploaded LaTeX) lives only here, so even
# if an upload achieves code execution it cannot reach the internet or the LAN.
# Only `cloudflared` bridges between this network and the outside world.
[Unit]
Description=latexdiff-zip internal network (no internet egress)

[Network]
NetworkName=ldz-internal
Internal=true
