# Cloudflare Tunnel token.
#
# Get it from the Zero Trust dashboard:
#   Networks -> Tunnels -> (your tunnel) -> Configure -> copy the token shown in
#   the "install connector" command (the long eyJ... string after `--token`).
#
# Then, on the host:
#   cp cloudflared.env.example ~/.config/containers/systemd/cloudflared.env
#   $EDITOR ~/.config/containers/systemd/cloudflared.env   # paste the token
#   chmod 600 ~/.config/containers/systemd/cloudflared.env
#
# Do NOT commit the real token.
TUNNEL_TOKEN=paste-your-tunnel-token-here
